{
  "family": "support-manager-api",
  "executionRoleArn": "arn:aws:iam::363720909149:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "support-manager-api",
      "image": "363720909149.dkr.ecr.eu-west-2.amazonaws.com/support-manager-api:latest",
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "essential": true,
      "environment": [{ "name": "NODE_ENV", "value": "production" }]
    }
  ]
}
